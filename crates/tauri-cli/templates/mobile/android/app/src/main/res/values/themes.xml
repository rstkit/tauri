<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.{{snake-case app.name}}" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
    </style>
    <!-- F44: Dialog theme for SheetWryActivity (partial-height bottom sheet).
         windowIsFloating=false keeps it full-width with no built-in margins. -->
    <style name="Theme.{{snake-case app.name}}.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
